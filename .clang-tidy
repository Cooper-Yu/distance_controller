# Review function size and naming; do not rename or split automatically.
Checks: '-*,readability-function-size,readability-identifier-naming'
# Thresholds and names are project conventions.
CheckOptions:
  # Requires a checker supporting IgnoreMacros; verified with LLVM 23.1.0.
  - key: readability-function-size.IgnoreMacros
    value: 'true'
  # Function size: 60 lines and 4 nesting levels; width and statements are separate.
  - key: readability-function-size.LineThreshold
    value: '60'
  - key: readability-function-size.NestingThreshold
    value: '4'
  # Naming: ImageProcessor / compute_error / target_distance_.
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
