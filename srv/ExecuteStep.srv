# Accept a step or return batch while manual mode is idle; response is not completion.
# action: forward/backward/left/right/relative/target/front_wall/resume/status/history/backtrack/return_to/finish/cancel.
string action
# distance: positive meters; for front_wall this is front-body clearance.
float64 distance
# relative: signed dx/dy; target: absolute odom x/y, meters.
float64 x
float64 y
# Zero speed/timeout/max_travel selects documented defaults. Dwell is literal seconds.
float64 speed
float64 dwell
# Empty or route: initial route axes; heading: persistent held-heading axes.
string frame
bool side_centering
float64 max_travel
float64 timeout
# Optional human-readable endpoint name for the recorded stopped pose.
string label
# Return controls; used only by backtrack / return_to. History is current-process only.
uint32 steps
bool use_visit_id
uint64 visit_id
---
bool accepted
string message
