digraph control {
  graph [rankdir=TB, bgcolor="white", pad="0.25", nodesep="0.3", ranksep="0.35"];
  node [shape=box, style="rounded,filled", fillcolor="#eef6fc", color="#5182a5", fontname="DejaVu Sans", fontsize=12];
  edge [color="#526674", fontname="DejaVu Sans", fontsize=10];
  start [label="on_timer() / 50 ms wall timer"];
  guard [label="Fault, feedback and node-time checks",shape=diamond];
  stop [label="publish_stop()\nEnd this tick",fillcolor="#fff1dc"];
  align [label="Initial alignment gate (scene 2)\nStable right-wall fit / rotate parallel\nStop; capture odom heading reference",shape=diamond];
  recover [label="Heading recovery (scene 2)\nRevoke drifted dwell / rotate only",shape=diamond];
  rotate [label="Publish initial adjustment or stop\nEnd this tick"];
  target [label="execute_current_segment()\nInitialize target once\nScene 2: centered A + wall-rotated route offsets"];
  valid [label="Target ready?",shape=diamond];
  errors [label="Read pose; calculate ex / ey"];
  done [label="Segment completed?",shape=diamond];
  dwell [label="handle_completed_segment()\nStop; wait for motion.dwell\nReturn Completed when ready",fillcolor="#e7f3e6"];
  near [label="Position error < 0.01 m?",shape=diamond];
  settle [label="Stop; reset PID; check_completion()\nVerify continuous standstill\nRoute: mark completed for dwell\nEnd this tick",fillcolor="#e7f3e6"];
  timing [label="Clear settling; handle_pid_timing()",shape=diamond];
  compute [label="compute_and_publish_command(data)\nPID -> speed limit -> acceleration limit\n-> body conversion + yaw correction -> publish"];
  log [label="log_control_state(data) when due\nEnd this tick"];
  start -> guard;
  guard -> stop [label="blocked"];
  scan [label="Preparation guard: scan / TF / travel\nStage deadline + total deadline",shape=diamond];
  center [label="Initial laser centering (scene 2)\nSide center + rear 0.28 m + yaw; stop; capture A",shape=diamond];
  guard -> scan [label="continue"];
  scan -> stop [label="blocked"];
  scan -> align [label="ready / already initialized / scene 1"];
  align -> rotate [label="pending"];
  align -> center [label="complete / scene 1"];
  center -> rotate [label="pending"];
  idle [label="Manual WAITING?\nCheck stopped-position drift; hold yaw\nAccept step / resume / history return",shape=diamond];
  feedback [label="apply_step_feedback()\nTime/path bounds + selected laser validity\nPosition / front clearance / side error",shape=diamond];
  center -> idle [label="complete / scene 1"];
  idle -> stop [label="waiting / finish"];
  idle -> target [label="active"];

  target -> valid;
  valid -> stop [label="no"];
  valid -> errors [label="yes"];
  errors -> feedback;
  feedback -> stop [label="fault"];
  feedback -> recover [label="valid"];
  recover -> rotate [label="rotation required"];
  recover -> done [label="continue"];
  done -> dwell [label="yes"];
  advance [label="on_timer(): Completed -> advance_route()\nCommit completed history; return leg / wait / next / exit"];
  dwell -> advance [label="finished"];
  dwell -> stop [label="waiting"];
  done -> near [label="no"];
  near -> settle [label="yes"];
  near -> timing [label="no"];
  timing -> stop [label="initialize / invalid dt"];
  timing -> compute [label="valid dt"];
  compute -> log;
}
