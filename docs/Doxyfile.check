# Run from the package root; leave the HTML documentation configuration intact.
@INCLUDE = docs/Doxyfile
INPUT = include src
OUTPUT_DIRECTORY = docs/generated
XML_OUTPUT = comment-check
GENERATE_HTML = NO
GENERATE_LATEX = NO
GENERATE_XML = YES
EXTRACT_ALL = NO
EXTRACT_PRIVATE = YES
EXTRACT_STATIC = YES
WARNINGS = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
WARN_NO_PARAMDOC = YES
WARN_AS_ERROR = NO
WARN_LOGFILE =
WARN_FORMAT = "$file:$line: $text"
FULL_PATH_NAMES = YES
STRIP_FROM_PATH =
QUIET = YES
